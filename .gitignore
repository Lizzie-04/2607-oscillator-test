# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Local configuration and logs
.env
.env.*
*.log
*.tmp
*.bak
*.swp
*.lnk

# Codex/tool support and one-off render output
.codex_work/
outputs/
tmp/
_staging/

# Quartus/Questa generated databases
**/db/
**/incremental_db/
**/work/
**/transcript
**/vsim.wlf
**/*.qws
**/*.rpt
**/*.chg
**/*.cmp
**/*.eqn
**/*.map
**/*.pin
**/*.smsg
**/*.summary~

# Keep the reviewed standalone programming images.
*.sof
!FPGA_V1/quartus/output_files/fpga_v1.sof
!FPGA_V2/quartus/output_files/fpga_v2.sof
!FPGA_V4/quartus/output_files/fpga_v4.sof

# GUI measurement output is local experiment data.
FPGA_V2/data/statistics/
FPGA_V4/data/statistics/

# Large third-party installation/media archives are reproducible downloads.
*.zip

# Operating-system/editor noise
.DS_Store
Thumbs.db
Desktop.ini

# Final source archive: retain existing per-version programming images.
!FPGA_V*/quartus/output_files/*.sof

# Runtime measurements and local dependency/render caches stay on the lab PC.
FPGA_V*/data/
.pydeps/
Allan_Deviation/*
!Allan_Deviation/run_allan_deviation.py
