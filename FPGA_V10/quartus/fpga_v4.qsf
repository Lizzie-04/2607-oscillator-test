set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CSEMA5F31C6
set_global_assignment -name TOP_LEVEL_ENTITY fpga_v2_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name VERILOG_INPUT_VERSION SYSTEMVERILOG_2005
set_global_assignment -name NUM_PARALLEL_PROCESSORS 4
set_global_assignment -name SEED 2
set_global_assignment -name RESERVE_ALL_UNUSED_PINS "AS INPUT TRI-STATED"
set_global_assignment -name ENABLE_SIGNALTAP OFF
set_global_assignment -name IGNORE_PARTITIONS ON

# The registered divide-by-25 clock drives the complete 2 MHz digital
# backend.  Force it onto a dedicated global clock network; allowing Quartus
# to route this 1300+ fan-out clock as ordinary fabric creates hold failures.
set_instance_assignment -name GLOBAL_SIGNAL "GLOBAL CLOCK" -to "core|dsm_clock|clk_2mhz"

set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/fpga_v2_protocol_pkg.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/chip_control_driver.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/control_word_unpack.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/clock_generator_2mhz.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/reset_synchronizer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/pulse_toggle_cdc.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/sample_mailbox_cdc.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/calibration_mailbox_cdc.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/filter_down_two_clock.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/statistics_capture_buffer.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/triangular_decimator_runtime.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/avalon_host_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/gpio_host_bridge.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/host_command_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/fpga_v2_core.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/fpga_v2_top.sv
set_global_assignment -name QIP_FILE oscv_jtag_master/synthesis/oscv_jtag_master.qip

set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/on_chip/filter_down.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/on_chip/divider.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/on_chip/poly_engine_system.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/on_chip/poly_engine_freq.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/on_chip/sar_calibrator.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/on_chip/adder.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/on_chip/filter_up.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/on_chip/digital_DSM.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../rtl/on_chip/digital_DSM_reference.sv
